# LOCAL development only (APP_ENV=local). All automated, e2e, load and stress
# tests run locally (APP_ENV=test is set by the test suite) with zero Supabase egress.
# Hosted services use .env.staging.example / .env.production.example as templates
# with secrets injected by the hosting platform. Never copy hosted secrets here.
APP_ENV=local
LOCAL_ONLY=true
DATABASE_BACKEND=memory
ENABLE_DEV_AUTH=false
# Loopback only (local Supabase CLI stack or none at all). Hosted refs are refused.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=mock-anon-key
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key
SUPABASE_JWT_SECRET=mock-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_MAX_CONCURRENT_QUERIES=16
DATABASE_QUERY_TIMEOUT_SECONDS=15
CORS_ORIGINS=["http://localhost:8081","http://localhost:3000"]
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=documents
DOCUMENT_RETENTION_DAYS=3
OPENROUTER_API_KEY=mock-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nvidia/embeddings-nv-embed-qa-4
MONTHLY_DOCUMENT_LIMIT=10
MAX_FILE_SIZE_MB=15
MAX_PAGE_COUNT=50
RATE_LIMIT_UPLOAD_PER_MINUTE=20
# Local convenience: the API runs queued jobs in-process after responding.
# Managed environments require INLINE_JOB_EXECUTION=false and separate workers.
INLINE_JOB_EXECUTION=true
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
CLEANUP_INTERVAL_SECONDS=900
# Local Supabase SDK rehearsals: DATABASE_BACKEND=supabase and supply the
# locally generated anon/service-role keys; only explicit loopback IPs are accepted.
# Local API tests/fixtures deny provider sockets and do not read private .env files.
