# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_BACKEND=supabase
DATABASE_MAX_CONCURRENT_QUERIES=16
DATABASE_QUERY_TIMEOUT_SECONDS=15
ENABLE_DEV_AUTH=false
CORS_ORIGINS=["http://localhost:8081","http://localhost:3000"]
# Local tests/demo only: DATABASE_BACKEND=memory, ENVIRONMENT=test/development.
# ENABLE_DEV_AUTH=true additionally opts into dummy tokens for local demos only.

# Storage Provider ('supabase' [default] or 's3')
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=documents
DOCUMENT_RETENTION_DAYS=3

# AWS S3 (Optional - only required if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=study-platform-documents
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# AI Provider (NVIDIA Nemotron via OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# App Constraints
MONTHLY_DOCUMENT_LIMIT=10
MAX_FILE_SIZE_MB=15
MAX_PAGE_COUNT=50

# Environment
ENVIRONMENT=development
