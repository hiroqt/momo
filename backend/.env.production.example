# Managed PRODUCTION template (Supabase project momo-prod).
# Production receives no test traffic of any kind: no automated, e2e, load or
# stress tests. This template does not authorize deployment. Inject secrets
# through the hosting platform's secret store; blank credentials and placeholder
# origins fail startup. The backend refuses to start against any other project.
APP_ENV=production
LOCAL_ONLY=false
DATABASE_BACKEND=supabase
ENABLE_DEV_AUTH=false
INLINE_JOB_EXECUTION=false
SUPABASE_URL=https://liyuyfqkbknxorzoekkq.supabase.co
SUPABASE_PROJECT_REF=liyuyfqkbknxorzoekkq
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Empty for managed asymmetric JWTs verified through the project's JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_MAX_CONCURRENT_QUERIES=16
DATABASE_QUERY_TIMEOUT_SECONDS=15
CORS_ORIGINS=["https://replace-production-app-origin.example"]
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=documents
DOCUMENT_RETENTION_DAYS=3
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Verify PRD model availability/semantic dimension compatibility before deployment.
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/embeddings-nv-embed-qa-4
MONTHLY_DOCUMENT_LIMIT=10
MAX_FILE_SIZE_MB=15
MAX_PAGE_COUNT=50
RATE_LIMIT_UPLOAD_PER_MINUTE=20
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
CLEANUP_INTERVAL_SECONDS=900
CLEANUP_OVERDUE_ALERT_SECONDS=3600
