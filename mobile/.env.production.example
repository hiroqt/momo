# Public client configuration only; never put server secrets here.
EXPO_PUBLIC_APP_ENV=production
# Set the matching HTTPS API origin after hosting is selected.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=https://liyuyfqkbknxorzoekkq.supabase.co
# Required public anon/publishable key only. Service-role/secret keys are rejected;
# hosted apps fail closed when this or the Supabase URL is missing. OAuth secrets stay in Supabase.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Must be allow-listed in Supabase Auth redirect URLs; matches app.json scheme.
EXPO_PUBLIC_AUTH_REDIRECT_URL=aistudy://auth/callback
