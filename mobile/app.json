{
  "expo": {
    "name": "momo",
    "slug": "momo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "aistudy",
    "splash": {
      "image": "./assets/animations/momo_loading.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aistudy.platform",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["instagram-stories", "instagram"],
        "NSPhotoLibraryUsageDescription": "Save Academic Weapon streak and study cards to your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Save Academic Weapon streak and study cards to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "navigationBar": {
        "backgroundColor": "#F8FAFC",
        "barStyle": "dark-content"
      },
      "package": "com.aistudy.platform",
      "queries": [
        {
          "package": "com.instagram.android"
        },
        {
          "intent": {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "instagram"
            }
          }
        },
        {
          "intent": {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "instagram-stories"
            }
          }
        },
        {
          "intent": {
            "action": "com.instagram.share.ADD_TO_STORY",
            "data": {
              "mimeType": "image/*"
            }
          }
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/animations/momo_loading.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Save Academic Weapon streak and study cards to your photo library.",
          "savePhotosPermission": "Save Academic Weapon streak and study cards to your photo library."
        }
      ]
    ]
  }
}
