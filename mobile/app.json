{
  "expo": {
    "name": "AI Study Platform",
    "slug": "ai-study-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "aistudy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aistudy.platform"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "navigationBar": {
        "backgroundColor": "#ffffff",
        "barStyle": "dark-content"
      },
      "package": "com.aistudy.platform"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-splash-screen", {
          "backgroundColor": "#ffffff",
          "image": "./assets/icon.png",
          "imageWidth": 100,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
