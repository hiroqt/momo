# Public client configuration only; never put server secrets here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon/publishable key only. Service-role/secret keys are rejected at startup.
# Configure Google OAuth in the selected Supabase project; staging setup is user-reported, but login/redirect remain unverified.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Must be allow-listed in Supabase Auth redirect URLs; matches app.json scheme.
EXPO_PUBLIC_AUTH_REDIRECT_URL=aistudy://auth/callback
# Development/test only: explicit token for a local backend with dummy auth enabled.
# Hosted builds refuse to start when this is set.
EXPO_PUBLIC_DEV_AUTH_TOKEN=
